        ompi_done="`expr $ompi_i \>= $ompi_count`"
        ompi_i="`expr $ompi_i + 1`"
    done

    # Done; do the assignment

    ompi_newval="`echo $ompi_newval`"
    ompi_eval="$ompi_name=\"$ompi_newval\""
