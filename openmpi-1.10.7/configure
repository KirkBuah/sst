$as_echo_n "checking final added libraries... " >&6; }
                  { $as_echo "$as_me:${as_lineno-$LINENO}: result: $opal_check_pmi_grpcomm_pmi_LIBS" >&5
$as_echo "$opal_check_pmi_grpcomm_pmi_LIBS" >&6; }
                  grpcomm_pmi_good=1
fi

fi


