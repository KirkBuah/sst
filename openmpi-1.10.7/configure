           if test ! -z "$with_pmi_libdir"; then :
  opal_check_pmi_lib_dir=$with_pmi_libdir
                  opal_default_libloc=no
else
  opal_check_pmi_lib_dir=$opal_check_pmi_install_dir
                  if test "$opal_default_loc" = "no"; then :
  opal_default_libloc=no
else
  opal_default_libloc=yes
