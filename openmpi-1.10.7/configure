        { $as_echo "$as_me:${as_lineno-$LINENO}: result: Linux" >&5
$as_echo "Linux" >&6; }
        hwloc_components="$hwloc_components linux"
	if test x$enable_pci != xno; then
	  hwloc_components="$hwloc_components linuxpci"

