  files=`ls -U $opal_check_pmi_lib_dir/lib64/libpmi2.* 2> /dev/null | wc -l`
                  if test "$files" -gt "0"; then :
  opal_have_pmi2=1
                         if test "$opal_default_libloc" = "no"; then :
  opal_check_pmi_db_pmi_LDFLAGS="-L$opal_check_pmi_lib_dir/lib64"
                                opal_pmi_rpath="$opal_check_pmi_lib_dir/lib64"
                                opal_pmi_added_ldflag=yes
fi
                         opal_check_pmi_db_pmi_LIBS="$opal_check_pmi_db_pmi_LIBS -lpmi2"
else
  files=`ls -U $opal_check_pmi_lib_dir/lib/libpmi2.* 2> /dev/null | wc -l`
                         if test "$files" -gt "0"; then :
  opal_have_pmi2=1
                                if test "$opal_default_libloc" = "no"; then :
  opal_check_pmi_db_pmi_LDFLAGS="-L$opal_check_pmi_lib_dir/lib"
                                       opal_pmi_rpath="$opal_check_pmi_lib_dir/lib"
                                       opal_pmi_added_ldflag=yes
fi
                                opal_check_pmi_db_pmi_LIBS="$opal_check_pmi_db_pmi_LIBS -lpmi2"
fi
fi
fi
           # check for pmi2.h
           if test "$opal_pmi_added_cppflag" = "no"; then :
  if test -f "$opal_check_pmi_install_dir/pmi2.h"; then :
  opal_check_pmi_have_hdr=yes
                         opal_check_pmi_db_pmi_CPPFLAGS="-I$opal_check_pmi_install_dir"
else
  if test -f "$opal_check_pmi_install_dir/include/pmi2.h"; then :
  opal_check_pmi_have_hdr=yes
                                if test "$opal_default_loc" = "no"; then :
  opal_check_pmi_db_pmi_CPPFLAGS="-I$opal_check_pmi_install_dir/include"
fi
else
  # this could be SLURM, which puts things in a different location
                               if test -f "$opal_check_pmi_install_dir/include/slurm/pmi2.h"; then :
  # even if this was the default loc, we still need to add it in
                                       # because of the slurm path addition
                                       opal_check_pmi_have_hdr=yes
                                        opal_check_pmi_db_pmi_CPPFLAGS="-I$opal_check_pmi_install_dir/include/slurm"
fi
fi
fi
fi

           # since support was explicitly requested, then we should error out
           # if we didn't find the required support
           { $as_echo "$as_me:${as_lineno-$LINENO}: checking if PMI support can be built" >&5
$as_echo_n "checking if PMI support can be built... " >&6; }
           if test "$opal_check_pmi_have_hdr" != "yes"; then :
  { $as_echo "$as_me:${as_lineno-$LINENO}: result: no" >&5
$as_echo "no" >&6; }
                  { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: PMI support requested (via --with-pmi) but neither pmi.h" >&5
$as_echo "$as_me: WARNING: PMI support requested (via --with-pmi) but neither pmi.h" >&2;}
                  { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: nor pmi2.h were found under locations:" >&5
$as_echo "$as_me: WARNING: nor pmi2.h were found under locations:" >&2;}
                  { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING:     $opal_check_pmi_install_dir" >&5
$as_echo "$as_me: WARNING:     $opal_check_pmi_install_dir" >&2;}
                  { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING:     $opal_check_pmi_install_dir/include" >&5
$as_echo "$as_me: WARNING:     $opal_check_pmi_install_dir/include" >&2;}
                  { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING:     $opal_check_pmi_install_dir/include/slurm" >&5
$as_echo "$as_me: WARNING:     $opal_check_pmi_install_dir/include/slurm" >&2;}
                  { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: Specified path: $with_pmi" >&5
$as_echo "$as_me: WARNING: Specified path: $with_pmi" >&2;}
                  as_fn_error $? "Aborting" "$LINENO" 5
                  db_pmi_good=0
fi

           if test "$opal_have_pmi1" != "1" && test "$opal_have_pmi2" != "1"; then :
  { $as_echo "$as_me:${as_lineno-$LINENO}: result: no" >&5
$as_echo "no" >&6; }
                  { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: PMI support requested but neither libpmi nor libpmi2 were found under:" >&5
$as_echo "$as_me: WARNING: PMI support requested but neither libpmi nor libpmi2 were found under:" >&2;}
                  { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING:     $opal_check_pmi_lib_dir/lib" >&5
$as_echo "$as_me: WARNING:     $opal_check_pmi_lib_dir/lib" >&2;}
                  { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING:     $opal_check_pmi_lib_dir/lib64" >&5
$as_echo "$as_me: WARNING:     $opal_check_pmi_lib_dir/lib64" >&2;}
                  { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: Specified path: $with_pmi_libdir" >&5
$as_echo "$as_me: WARNING: Specified path: $with_pmi_libdir" >&2;}
                  as_fn_error $? "Aborting" "$LINENO" 5
                  db_pmi_good=0
else
  { $as_echo "$as_me:${as_lineno-$LINENO}: result: yes" >&5
$as_echo "yes" >&6; }
                  opal_enable_pmi=1
                  db_pmi_LDFLAGS="$opal_check_pmi_db_pmi_LDFLAGS"
                  db_pmi_CPPFLAGS="$opal_check_pmi_db_pmi_CPPFLAGS"
                  db_pmi_LIBS="$opal_check_pmi_db_pmi_LIBS  -Wl,-rpath=$opal_pmi_rpath"
                  { $as_echo "$as_me:${as_lineno-$LINENO}: checking final added libraries" >&5
$as_echo_n "checking final added libraries... " >&6; }
                  { $as_echo "$as_me:${as_lineno-$LINENO}: result: $opal_check_pmi_db_pmi_LIBS" >&5
$as_echo "$opal_check_pmi_db_pmi_LIBS" >&6; }
                  db_pmi_good=1
fi

fi


cat >>confdefs.h <<_ACEOF
#define WANT_PMI_SUPPORT $opal_enable_pmi
_ACEOF


