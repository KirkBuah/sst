{ $as_echo "$as_me:${as_lineno-$LINENO}: result: $ompi_cv_fortran_int_kind_4" >&5
$as_echo "$ompi_cv_fortran_int_kind_4" >&6; }

    # All analysis of $value is done in the upper-level / calling
    # macro

    value=$ompi_cv_fortran_int_kind_4

