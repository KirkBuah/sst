                  as_fn_error $? "Aborting" "$LINENO" 5
                  pubsub_pmi_good=0
else
  { $as_echo "$as_me:${as_lineno-$LINENO}: result: yes" >&5
$as_echo "yes" >&6; }
                  opal_enable_pmi=1
                  pubsub_pmi_LDFLAGS="$opal_check_pmi_pubsub_pmi_LDFLAGS"
                  pubsub_pmi_CPPFLAGS="$opal_check_pmi_pubsub_pmi_CPPFLAGS"
