        if test "$happy" = "no" ; then
            { $as_echo "$as_me:${as_lineno-$LINENO}: result: Error!" >&5
$as_echo "Error!" >&6; }
            as_fn_error $? "Could not determine alignment of INTEGER*1" "$LINENO" 5
