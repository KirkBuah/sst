_ACEOF

     if test $OMPI_BUILD_FORTRAN_MPIFH_BINDINGS -eq 1; then
  OMPI_BUILD_FORTRAN_MPIFH_BINDINGS_TRUE=
  OMPI_BUILD_FORTRAN_MPIFH_BINDINGS_FALSE='#'
else
  OMPI_BUILD_FORTRAN_MPIFH_BINDINGS_TRUE='#'
  OMPI_BUILD_FORTRAN_MPIFH_BINDINGS_FALSE=
fi


