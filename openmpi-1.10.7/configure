    if test "$compile_mode" = "dso" ; then
        BUILD_ompi_fcoll_ylib_DSO=1
    else
        BUILD_ompi_fcoll_ylib_DSO=0
    fi
     if test "$BUILD_ompi_fcoll_ylib_DSO" = "1"; then
  MCA_BUILD_ompi_fcoll_ylib_DSO_TRUE=
