                          MCA_ompi_FRAMEWORK_LIBS="$MCA_ompi_FRAMEWORK_LIBS \$(MCA_ompi_fcoll_STATIC_LTLIBS)"

    # An AC-ARG-ENABLE for mpi-io was set in ompi/mca/io/configure.m4.
    # If it's no, we shouldn't bother building anything in fcoll.
    if test "$enable_mpi_io" != "no"; then :
  want_mpi_io=1
else
  want_mpi_io=0
