    { $as_echo "$as_me:${as_lineno-$LINENO}: checking --with-portals4-libdir value" >&5
$as_echo_n "checking --with-portals4-libdir value... " >&6; }
    if test "$with_portals4_libdir" = "yes" -o "$with_portals4_libdir" = "no" -o "x$with_portals4_libdir" = "x"; then :
  { $as_echo "$as_me:${as_lineno-$LINENO}: result: simple ok (unspecified)" >&5
$as_echo "simple ok (unspecified)" >&6; }
