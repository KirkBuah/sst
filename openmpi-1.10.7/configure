    MCA_opal_event_DSO_SUBDIRS=
    for item in $dso_components ; do
       MCA_opal_event_DSO_SUBDIRS="$MCA_opal_event_DSO_SUBDIRS mca/event/$item"
    done



    # Create the final .h file that will be included in the type's
