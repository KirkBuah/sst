                            eval "line=$line"
                            if test -n "$line"; then
                                rml_all_components_WRAPPER_EXTRA_LIBS="$line"
                            fi
                                        fi




    # See if it dropped an output file for us to pick up some
    # shell variables in.
    infile="$srcdir/orte/mca/rml/$component/post_configure.sh"

