        # post_configure.sh, but the file didn't exist?
        if test "$DIRECT_rcache" = "vma" ; then
as_fn_error $? "*** rcache component vma was supposed to be direct-called, but
*** does not appear to support direct calling.
*** Aborting" "$LINENO" 5
