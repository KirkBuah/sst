  OMPI_BUILD_FORTRAN_USEMPI_TKR_BINDINGS_TRUE=
  OMPI_BUILD_FORTRAN_USEMPI_TKR_BINDINGS_FALSE='#'
else
  OMPI_BUILD_FORTRAN_USEMPI_TKR_BINDINGS_TRUE='#'
  OMPI_BUILD_FORTRAN_USEMPI_TKR_BINDINGS_FALSE=
