  files=`ls -U $opal_check_pmi_lib_dir/lib64/libpmi.* 2> /dev/null | wc -l`
                  if test "$files" -gt "0"; then :
  opal_have_pmi1=1
                         if test "$opal_default_libloc" = "no"; then :
  opal_check_pmi_ess_pmi_LDFLAGS="-L$opal_check_pmi_lib_dir/lib64"
