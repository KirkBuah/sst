  opal_append=0
fi
               done
fi
        if test "$opal_append" = "1"; then :
  if test -z "$mca_wrapper_extra_libs"; then :
  mca_wrapper_extra_libs=$arg
else
  mca_wrapper_extra_libs="$mca_wrapper_extra_libs $arg"
fi
fi
    done


