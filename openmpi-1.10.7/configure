_ACEOF
 ompi_check_package_header_happy="yes"
fi

done

            if test "$ompi_check_package_header_happy" = "no"; then :
  # no go on the as is - reset the cache and try again
                   unset ac_cv_header_sqlite3_h
fi
fi

    if test "$ompi_check_package_header_happy" = "no"; then :
  if test "$opal_check_sqlite3_dir" != ""; then :
  db_sqlite_CPPFLAGS="$db_sqlite_CPPFLAGS -I$opal_check_sqlite3_dir/include"
                  CPPFLAGS="$CPPFLAGS -I$opal_check_sqlite3_dir/include"
fi
          for ac_header in sqlite3.h
do :
  ac_fn_c_check_header_mongrel "$LINENO" "sqlite3.h" "ac_cv_header_sqlite3_h" "$ac_includes_default"
if test "x$ac_cv_header_sqlite3_h" = xyes; then :
  cat >>confdefs.h <<_ACEOF
#define HAVE_SQLITE3_H 1
_ACEOF
 ompi_check_package_header_happy="yes"
fi

done

	  if test "$ompi_check_package_header_happy" = "yes"; then :

    # This is stolen from autoconf to peek under the covers to get the
    # cache variable for the library check.  one should not copy this
    # code into other places unless you want much pain and suffering


    # see comment above
    unset ac_cv_search_sqlite3_open
    ompi_check_package_lib_happy="no"
    if test "" != ""; then :
   # libdir was specified - search only there
           db_sqlite_LDFLAGS="$db_sqlite_LDFLAGS -L"
           LDFLAGS="$LDFLAGS -L"
           { $as_echo "$as_me:${as_lineno-$LINENO}: checking for library containing sqlite3_open" >&5
$as_echo_n "checking for library containing sqlite3_open... " >&6; }
if ${ac_cv_search_sqlite3_open+:} false; then :
  $as_echo_n "(cached) " >&6
else
  ac_func_search_save_LIBS=$LIBS
