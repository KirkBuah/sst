        "$SHARED_COMPONENT" = "1" -o \
        "$DSO_all" = "1"; then
        compile_mode="dso"
    else
        compile_mode="static"
    fi

    { $as_echo "$as_me:${as_lineno-$LINENO}: checking for MCA component dpm:orte compile mode" >&5
$as_echo_n "checking for MCA component dpm:orte compile mode... " >&6; }
    if test "$DIRECT_dpm" = "orte" ; then
        { $as_echo "$as_me:${as_lineno-$LINENO}: result: $compile_mode - direct" >&5
