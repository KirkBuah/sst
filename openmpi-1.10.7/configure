    # that we can unset them at the end of the scope.
    ompi_str="ompi_scope_$ompi_scope_index=\"opal_tmp opal_append\""
    eval $ompi_str
    unset ompi_str

    env | grep ompi_scope
    ompi_scope_index=`expr $ompi_scope_index + 1`


