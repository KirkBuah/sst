    if test "$DISABLE_rml" = "1"; then :
  want_component=0
fi
    str="DISABLED_COMPONENT_CHECK=\$DISABLE_rml_$component"
         eval $str
         if test "$DISABLED_COMPONENT_CHECK" = "1" ; then
             want_component=0
         fi

    if test "$want_component" = "1"; then :
  should_build=1
else
  should_build=0
fi


