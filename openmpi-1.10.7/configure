    # Add correct -I and -L flags
    if test -d "$with_pvfs2/include"; then :
  check_pvfs2_CPPFLAGS="-I$with_pvfs2/include"
            fbtl_pvfs2_CPPFLAGS="$check_pvfs2_CPPFLAGS"
