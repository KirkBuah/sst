    unset all_components static_components dso_components outfile outfile_real

                                 MCA_ompi_FRAMEWORKS="$MCA_ompi_FRAMEWORKS crcp"
                                 MCA_ompi_FRAMEWORKS_SUBDIRS="$MCA_ompi_FRAMEWORKS_SUBDIRS mca/crcp"
