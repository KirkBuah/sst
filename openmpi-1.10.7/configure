    # set the AM_CONDITIONAL on how we should build
    if test "$compile_mode" = "dso" ; then
        BUILD_orte_state_hnp_DSO=1
    else
        BUILD_orte_state_hnp_DSO=0
    fi
     if test "$BUILD_orte_state_hnp_DSO" = "1"; then
