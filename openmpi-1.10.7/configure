{ $as_echo "$as_me:${as_lineno-$LINENO}: result: $ac_cv_search_sqlite3_open" >&5
$as_echo "$ac_cv_search_sqlite3_open" >&6; }
ac_res=$ac_cv_search_sqlite3_open
