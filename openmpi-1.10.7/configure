    if test "$ompi_check_ugni_dir" = "/usr" -o "$ompi_check_ugni_dir" = "/usr/local"; then :
   # try as is...
            { $as_echo "$as_me:${as_lineno-$LINENO}: result: looking for header without includes" >&5
$as_echo "looking for header without includes" >&6; }
            for ac_header in ugni.h
do :
  ac_fn_c_check_header_mongrel "$LINENO" "ugni.h" "ac_cv_header_ugni_h" "$ac_includes_default"
if test "x$ac_cv_header_ugni_h" = xyes; then :
  cat >>confdefs.h <<_ACEOF
