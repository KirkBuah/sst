  --with-psm2-libdir=DIR  Search for PSM (Intel PSM2) libraries in DIR
  --with-ucx(=DIR)        Build with Unified Communication X library support
  --with-ucx-libdir=DIR   Search for Unified Communication X libraries in DIR
