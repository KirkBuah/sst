$as_echo "none (use mpi_f08 disabled)" >&6; }
else
  if test "$enable_mpi_f08_subarray_prototype" = "yes"; then :
  OMPI_BUILD_FORTRAN_F08_SUBARRAYS=1
              { $as_echo "$as_me:${as_lineno-$LINENO}: result: extra crispy (subarray prototype)" >&5
$as_echo "extra crispy (subarray prototype)" >&6; }
              { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: Sorry, the subarray prototype is no longer available" >&5
$as_echo "$as_me: WARNING: Sorry, the subarray prototype is no longer available" >&2;}
              { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: Contact your favorite OMPI developer and ask for it to be re-enabled" >&5
$as_echo "$as_me: WARNING: Contact your favorite OMPI developer and ask for it to be re-enabled" >&2;}
              as_fn_error $? "Cannot continue" "$LINENO" 5
else
  { $as_echo "$as_me:${as_lineno-$LINENO}: result: regular (no subarray support)" >&5
$as_echo "regular (no subarray support)" >&6; }
