ac_compiler_gnu=$ac_cv_fc_compiler_gnu

         cat > conftest.$ac_ext <<_ACEOF
program main
  REAL :: bogus_variable
end program
_ACEOF
if ac_fn_fc_try_compile "$LINENO"; then :
  ompi_cv_fortran_have_REAL=yes
else
  ompi_cv_fortran_have_REAL=no
