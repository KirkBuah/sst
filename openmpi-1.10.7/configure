if { { eval echo "\"\$as_me\":${as_lineno-$LINENO}: \"$ompi_assemble\""; } >&5
  (eval $ompi_assemble) 2>&5
  ac_status=$?
  $as_echo "$as_me:${as_lineno-$LINENO}: \$? = $ac_status" >&5
  test $ac_status = 0; }; then
  # save the warnings
