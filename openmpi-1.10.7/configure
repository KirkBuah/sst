`cat $outfile.extern`

const mca_base_component_t *mca_mtl_base_static_components[] = {
`cat $outfile.struct`
  NULL
};

#if defined(c_plusplus) || defined(__cplusplus)
}
#endif

EOF
        # Only replace the header file if a) it doesn't previously
