    { $as_echo "$as_me:${as_lineno-$LINENO}: checking if Fortran compiler supports REAL*8" >&5
$as_echo_n "checking if Fortran compiler supports REAL*8... " >&6; }
if ${ompi_cv_fortran_have_REALp8+:} false; then :
