else
  { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: ignoring spml_ikrit_WRAPPER_EXTRA_CPPFLAGS ($spml_ikrit_WRAPPER_EXTRA_CPPFLAGS): component conditions not met" >&5
