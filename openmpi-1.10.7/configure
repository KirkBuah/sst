    if test "$with_allocator" = "bucket" ; then
        { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: MCA component \"bucket\" failed to configure properly" >&5
$as_echo "$as_me: WARNING: MCA component \"bucket\" failed to configure properly" >&2;}
