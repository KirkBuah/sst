    { $as_echo "$as_me:${as_lineno-$LINENO}: checking if MCA component dfs:$component can compile" >&5
$as_echo_n "checking if MCA component dfs:$component can compile... " >&6; }
    { $as_echo "$as_me:${as_lineno-$LINENO}: result: no" >&5
$as_echo "no" >&6; }

    # If this component was requested as the default for this
    # type, then abort.
    if test "$with_dfs" = "$component" ; then
