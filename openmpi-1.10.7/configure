                                 MCA_orte_FRAMEWORK_LIBS="$MCA_orte_FRAMEWORK_LIBS mca/grpcomm/libmca_grpcomm.la"
                          MCA_orte_FRAMEWORK_LIBS="$MCA_orte_FRAMEWORK_LIBS \$(MCA_orte_grpcomm_STATIC_LTLIBS)"

