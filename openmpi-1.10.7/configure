        # to be built.  Otherwise, we do want to be built.
        if test ! -z "$DIRECT_vprotocol" ; then
            if test "$DIRECT_vprotocol" = "$component" ; then
                want_component=1
            else
                want_component=0
            fi
        fi
    fi

    # if we were explicitly disabled, don't build :)
    if test "$DISABLE_vprotocol" = "1"; then :
  want_component=0
