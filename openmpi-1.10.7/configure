	{ $as_echo "$as_me:${as_lineno-$LINENO}: $sub_configure *failed* for $subdir_dir" >&5
$as_echo "$as_me: $sub_configure *failed* for $subdir_dir" >&6;}
    fi

    #
    # Go back to the topdir
    #

    cd $subdir_parent
fi

#
# Clean up
#


    # Unwind the index
