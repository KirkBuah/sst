        echo "  &mca_dfs_$component_component, " >> $outfile.struct
        static_components="$static_components $component"
    fi

    # Output pretty results
    { $as_echo "$as_me:${as_lineno-$LINENO}: checking if MCA component dfs:$component can compile" >&5
$as_echo_n "checking if MCA component dfs:$component can compile... " >&6; }
    { $as_echo "$as_me:${as_lineno-$LINENO}: result: yes" >&5
$as_echo "yes" >&6; }

                        if test -f $infile; then
        # check for direct call header to include.  This will be
        # AC_SUBSTed later.
        if test "$DIRECT_dfs" = "$component" ; then
            if test "`$GREP DIRECT_CALL_HEADER $infile`" != "" ; then
