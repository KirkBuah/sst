  for val in ${mca_wrapper_extra_cppflags}; do
                   if test "x$val" = "x$arg"; then :
  opal_append=0
fi
               done
fi
        if test "$opal_append" = "1"; then :
  if test -z "$mca_wrapper_extra_cppflags"; then :
  mca_wrapper_extra_cppflags=$arg
else
  mca_wrapper_extra_cppflags="$mca_wrapper_extra_cppflags $arg"
fi
fi
    done


    # Unwind the index
    ompi_scope_index=`expr $ompi_scope_index - 1`
    ompi_scope_test=`expr $ompi_scope_index \> 0`
    if test "$ompi_scope_test" = "0"; then
        { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: OPAL_VAR_SCOPE_POP popped too many OMPI configure scopes." >&5
