        unset $ompi_var
    done


    fi

    # if needed, copy over WRAPPER_EXTRA_CPPFLAGS.  Since a configure script
    # component can never be used in a STOP_AT_FIRST framework, we
    # don't have to implement the else clause in the literal check...


