  cat >>confdefs.h <<_ACEOF
#define HAVE_PVFS2_H 1
_ACEOF
 { $as_echo "$as_me:${as_lineno-$LINENO}: checking if possible to link PVFS2" >&5
$as_echo_n "checking if possible to link PVFS2... " >&6; }
		    cat confdefs.h - <<_ACEOF >conftest.$ac_ext
/* end confdefs.h.  */
#include <stdio.h>
				  #include <pvfs2.h>
int
main ()
{
PVFS_util_resolve(NULL,NULL,NULL,0);
  ;
  return 0;
}
_ACEOF
if ac_fn_c_try_link "$LINENO"; then :
  { $as_echo "$as_me:${as_lineno-$LINENO}: result: yes" >&5
$as_echo "yes" >&6; }
			    ompi_check_pvfs2_happy="yes"
else
  { $as_echo "$as_me:${as_lineno-$LINENO}: result: no" >&5
$as_echo "no" >&6; }
			    ompi_check_pvfs2_happy="no"
fi
rm -f core conftest.err conftest.$ac_objext \
    conftest$ac_exeext conftest.$ac_ext
else
  ompi_check_pvfs2_happy="no"
fi

done


fi


    LDFLAGS="$check_pvfs2_save_LDFLAGS"
    CPPFLAGS="$check_pvfs2_save_CPPFLAGS"
    LIBS="$check_pvfs2_save_LIBS"
    if test "$ompi_check_pvfs2_happy" = "yes"; then :
  fbtl_pvfs2_happy="yes"
