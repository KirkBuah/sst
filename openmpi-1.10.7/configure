    fi

           # add component to all component list
           all_components="$all_components blcr"
fi



    # set the AM_CONDITIONAL on how we should build
    if test "$compile_mode" = "dso"; then :
  BUILD_opal_crs_blcr_DSO=1
else
  BUILD_opal_crs_blcr_DSO=0
fi
     if test "$BUILD_opal_crs_blcr_DSO" = "1"; then
  MCA_BUILD_opal_crs_blcr_DSO_TRUE=
  MCA_BUILD_opal_crs_blcr_DSO_FALSE='#'
else
  MCA_BUILD_opal_crs_blcr_DSO_TRUE='#'
  MCA_BUILD_opal_crs_blcr_DSO_FALSE=
