                  { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: Directory $with_portals4_libdir not found" >&5
$as_echo "$as_me: WARNING: Directory $with_portals4_libdir not found" >&2;}
                  as_fn_error $? "Cannot continue" "$LINENO" 5
