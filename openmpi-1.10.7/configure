    # set the AM_CONDITIONAL on how we should build
    if test "$compile_mode" = "dso" ; then
        BUILD_ompi_mpool_sm_DSO=1
    else
        BUILD_ompi_mpool_sm_DSO=0
    fi
     if test "$BUILD_ompi_mpool_sm_DSO" = "1"; then
  MCA_BUILD_ompi_mpool_sm_DSO_TRUE=
