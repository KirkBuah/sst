                   { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: Compiler INTEGER*4 and $ofc_c_type mismatch; MPI datatype unsupported" >&5
$as_echo "$as_me: WARNING: Compiler INTEGER*4 and $ofc_c_type mismatch; MPI datatype unsupported" >&2;}
