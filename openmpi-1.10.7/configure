    else
        { $as_echo "$as_me:${as_lineno-$LINENO}: checking if Fortran compiler supports INTEGER*16" >&5
$as_echo_n "checking if Fortran compiler supports INTEGER*16... " >&6; }
        { $as_echo "$as_me:${as_lineno-$LINENO}: result: skipped" >&5
$as_echo "skipped" >&6; }
