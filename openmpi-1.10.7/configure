        # post_configure.sh, but the file didn't exist?
        if test "$DIRECT_fcoll" = "$component" ; then
as_fn_error $? "*** fcoll component $component was supposed to be direct-called, but
*** does not appear to support direct calling.
*** Aborting" "$LINENO" 5
