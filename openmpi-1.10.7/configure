$as_echo "$as_me: WARNING: Please reconfigure the --with-jdk options to where Java" >&2;}
               { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: support can be found" >&5
$as_echo "$as_me: WARNING: support can be found" >&2;}
