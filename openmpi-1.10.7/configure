$as_echo_n "checking for liblsf yp requirements... " >&6; }
	   { $as_echo "$as_me:${as_lineno-$LINENO}: result: $yp_all_nsl_happy" >&5
$as_echo "$yp_all_nsl_happy" >&6; }

