                                 MCA_ompi_FRAMEWORK_COMPONENT_DSO_SUBDIRS="$MCA_ompi_FRAMEWORK_COMPONENT_DSO_SUBDIRS \$(MCA_ompi_crcp_DSO_SUBDIRS)"
