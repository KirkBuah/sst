  $as_echo_n "(cached) " >&6
else
   # Loop over all the types handed to us
         oft_real_type=
         if test "$oft_target_size" != ""; then :
  if test -z "$oft_real_type"; then
                       if test "$ac_cv_sizeof_float__Complex" = "$oft_target_size" ; then
                           oft_real_type="float _Complex"
