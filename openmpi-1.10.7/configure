$as_echo "$OPAL_WRAPPER_EXTRA_CXXFLAGS_PREFIX" >&6; }

       { $as_echo "$as_me:${as_lineno-$LINENO}: checking for OPAL LDFLAGS" >&5
$as_echo_n "checking for OPAL LDFLAGS... " >&6; }
