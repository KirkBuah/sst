           if test "$ompi_check_package_lib_happy" = "no"; then :
  LDFLAGS="$ompi_check_package_btl_scif_save_LDFLAGS"
                  btl_scif_LDFLAGS="$ompi_check_package_btl_scif_orig_LDFLAGS"
