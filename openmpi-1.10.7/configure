$as_echo "$ompi_cv_fortran_alignment_LOGICALp8" >&6; }

    ofc_type_alignment=$ompi_cv_fortran_alignment_LOGICALp8

    # Unwind the index
    ompi_scope_index=`expr $ompi_scope_index - 1`
