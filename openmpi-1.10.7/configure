        open(unit = 7, file = "conftest.out")
        write(7, *) $ofc_type_kind
        close(7)

      end
_ACEOF
if ac_fn_fc_try_run "$LINENO"; then :
  value=`cat conftest.out | awk '{print $1}'`
else
  value=no
