    # Use of m4_translit suggested by Eric Blake:
    # http://lists.gnu.org/archive/html/bug-autoconf/2010-10/msg00016.html


    { $as_echo "$as_me:${as_lineno-$LINENO}: checking size of Fortran INTEGER*4" >&5
