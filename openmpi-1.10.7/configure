                  { $as_echo "$as_me:${as_lineno-$LINENO}: checking final added libraries" >&5
$as_echo_n "checking final added libraries... " >&6; }
                  { $as_echo "$as_me:${as_lineno-$LINENO}: result: $opal_check_pmi_pubsub_pmi_LIBS" >&5
$as_echo "$opal_check_pmi_pubsub_pmi_LIBS" >&6; }
                  pubsub_pmi_good=1
fi

fi


cat >>confdefs.h <<_ACEOF
