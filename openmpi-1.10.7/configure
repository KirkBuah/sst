  MCA_BUILD_opal_sec_basic_DSO_TRUE='#'
  MCA_BUILD_opal_sec_basic_DSO_FALSE=
fi


    ac_config_files="$ac_config_files opal/mca/sec/basic/Makefile"


    unset compile_mode


    # configure components that use built-in configuration scripts



    best_mca_component_priority=0
    components_looking_for_succeed=1
    components_last_result=0


    ompi_show_subsubsubtitle "MCA component sec:keystone (m4 configuration macro)"




    component_path="$srcdir/opal/mca/sec/keystone"
    want_component=0

    # build if:
    # - the component type is direct and we are that component
    # - there is no ompi_ignore file
    # - there is an ompi_ignore, but there is an empty ompi_unignore
    # - there is an ompi_ignore, but username is in ompi_unignore
    if test -d $component_path ; then
        # decide if we want the component to be built or not.  This
        # is spread out because some of the logic is a little complex
        # and test's syntax isn't exactly the greatest.  We want to
        # build the component by default.
        want_component=1
        if test -f $component_path/.ompi_ignore ; then
            # If there is an ompi_ignore file, don't build
            # the component.  Note that this decision can be
            # overridden by the unignore logic below.
            want_component=0
        fi
        if test -f $component_path/.ompi_unignore ; then
            # if there is an empty ompi_unignore, that is
            # equivalent to having your userid in the unignore file.
            # If userid is in the file, unignore the ignore file.
            if test ! -s $component_path/.ompi_unignore ; then
                want_component=1
            elif test ! -z "`$GREP $OPAL_CONFIGURE_USER $component_path/.ompi_unignore`" ; then
                want_component=1
            fi
        fi
        # if this component type is direct and we are not it, we don't want
        # to be built.  Otherwise, we do want to be built.
        if test ! -z "$DIRECT_sec" ; then
            if test "$DIRECT_sec" = "keystone" ; then
                want_component=1
            else
                want_component=0
            fi
        fi
    fi

    # if we were explicitly disabled, don't build :)
    if test "$DISABLE_sec" = "1"; then :
  want_component=0
fi
    if test "$DISABLE_sec_keystone" = "1"; then :
  want_component=0
fi

    if test "$want_component" = "1"; then :
  should_build=$components_looking_for_succeed
else
  should_build=0
fi

    # Allow the component to override the build mode if it really wants to.
    # It is, of course, free to end up calling MCA_COMPONENT_COMPILE_MODE

    SHARED_FRAMEWORK="$DSO_sec"
    SHARED_COMPONENT="$DSO_sec_keystone"

    STATIC_FRAMEWORK="$STATIC_sec"
    STATIC_COMPONENT="$STATIC_sec_keystone"

    shared_mode_override=static

    # Setup for either shared or static
    if test "$STATIC_FRAMEWORK" = "1" -o \
        "$STATIC_COMPONENT" = "1" -o \
        "$STATIC_all" = "1" ; then
        compile_mode="static"
    elif test "$shared_mode_override" = "dso" -o \
        "$SHARED_FRAMEWORK" = "1" -o \
        "$SHARED_COMPONENT" = "1" -o \
        "$DSO_all" = "1"; then
        compile_mode="dso"
    else
        compile_mode="static"
    fi

    { $as_echo "$as_me:${as_lineno-$LINENO}: checking for MCA component sec:keystone compile mode" >&5
$as_echo_n "checking for MCA component sec:keystone compile mode... " >&6; }
    if test "$DIRECT_sec" = "keystone" ; then
        { $as_echo "$as_me:${as_lineno-$LINENO}: result: $compile_mode - direct" >&5
$as_echo "$compile_mode - direct" >&6; }
    else
        { $as_echo "$as_me:${as_lineno-$LINENO}: result: $compile_mode" >&5
$as_echo "$compile_mode" >&6; }
    fi


    # try to configure the component.  pay no attention to
    # --enable-dist, since we'll always have makefiles.

    ac_config_files="$ac_config_files opal/mca/sec/keystone/Makefile"



# Check whether --with-keystone was given.
if test "${with_keystone+set}" = set; then :
  withval=$with_keystone;
else
  with_keystone=no
fi


    # do not build if support not requested
    { $as_echo "$as_me:${as_lineno-$LINENO}: checking want keystone security" >&5
$as_echo_n "checking want keystone security... " >&6; }
    if test "$with_keystone" != "no"; then :
  { $as_echo "$as_me:${as_lineno-$LINENO}: result: yes" >&5
$as_echo "yes" >&6; }
           if test ! -z "$with_keystone" -a "$with_keystone" != "yes"; then :
  opal_check_keystone_dir="$with_keystone"
fi

    ompi_check_package_sec_keystone_save_CPPFLAGS="$CPPFLAGS"
    ompi_check_package_sec_keystone_save_LDFLAGS="$LDFLAGS"
    ompi_check_package_sec_keystone_save_LIBS="$LIBS"

    ompi_check_package_sec_keystone_orig_CPPFLAGS="$sec_keystone_CPPFLAGS"
    ompi_check_package_sec_keystone_orig_LDFLAGS="$sec_keystone_LDFLAGS"
    ompi_check_package_sec_keystone_orig_LIBS="$sec_keystone_LIBS"


    # This is stolen from autoconf to peek under the covers to get the
    # cache variable for the library check.  one should not copy this
    # code into other places unless you want much pain and suffering


    # so this sucks, but there's no way to get through the progression
    # of header includes without killing off the cache variable and trying
    # again...
    unset ac_cv_header_curl_curl_h

    ompi_check_package_header_happy="no"
    if test "" = "/usr" -o "" = "/usr/local"; then :
   # try as is...
            { $as_echo "$as_me:${as_lineno-$LINENO}: result: looking for header without includes" >&5
$as_echo "looking for header without includes" >&6; }
            for ac_header in curl/curl.h
do :
  ac_fn_c_check_header_mongrel "$LINENO" "curl/curl.h" "ac_cv_header_curl_curl_h" "$ac_includes_default"
if test "x$ac_cv_header_curl_curl_h" = xyes; then :
  cat >>confdefs.h <<_ACEOF
#define HAVE_CURL_CURL_H 1
_ACEOF
 ompi_check_package_header_happy="yes"
fi

done

            if test "$ompi_check_package_header_happy" = "no"; then :
  # no go on the as is - reset the cache and try again
                   unset ac_cv_header_curl_curl_h
fi
fi

    if test "$ompi_check_package_header_happy" = "no"; then :
  if test "" != ""; then :
  sec_keystone_CPPFLAGS="$sec_keystone_CPPFLAGS -I/include"
                  CPPFLAGS="$CPPFLAGS -I/include"
fi
          for ac_header in curl/curl.h
do :
  ac_fn_c_check_header_mongrel "$LINENO" "curl/curl.h" "ac_cv_header_curl_curl_h" "$ac_includes_default"
if test "x$ac_cv_header_curl_curl_h" = xyes; then :
  cat >>confdefs.h <<_ACEOF
#define HAVE_CURL_CURL_H 1
_ACEOF
 ompi_check_package_header_happy="yes"
fi

done

	  if test "$ompi_check_package_header_happy" = "yes"; then :

    # This is stolen from autoconf to peek under the covers to get the
    # cache variable for the library check.  one should not copy this
    # code into other places unless you want much pain and suffering


    # see comment above
    unset ac_cv_search_curl_easy_init
    ompi_check_package_lib_happy="no"
    if test "" != ""; then :
   # libdir was specified - search only there
           sec_keystone_LDFLAGS="$sec_keystone_LDFLAGS -L"
           LDFLAGS="$LDFLAGS -L"
           { $as_echo "$as_me:${as_lineno-$LINENO}: checking for library containing curl_easy_init" >&5
$as_echo_n "checking for library containing curl_easy_init... " >&6; }
if ${ac_cv_search_curl_easy_init+:} false; then :
  $as_echo_n "(cached) " >&6
else
  ac_func_search_save_LIBS=$LIBS
