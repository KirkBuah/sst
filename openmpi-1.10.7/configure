{
__sync_synchronize()
  ;
  return 0;
}
_ACEOF
if ac_fn_c_try_compile "$LINENO"; then :
  { $as_echo "$as_me:${as_lineno-$LINENO}: result: yes" >&5
$as_echo "yes" >&6; }
     ompi_cv_asm_builtin="BUILTIN_SYNC"
else
  { $as_echo "$as_me:${as_lineno-$LINENO}: result: no" >&5
$as_echo "no" >&6; }
     as_fn_error $? "__sync builtin atomics requested but not found." "$LINENO" 5
fi
rm -f core conftest.err conftest.$ac_objext conftest.$ac_ext


$as_echo "#define OPAL_C_GCC_INLINE_ASSEMBLY 1" >>confdefs.h

    elif test "$enable_osx_builtin_atomics" = "yes" ; then
	   ac_fn_c_check_header_mongrel "$LINENO" "libkern/OSAtomic.h" "ac_cv_header_libkern_OSAtomic_h" "$ac_includes_default"
