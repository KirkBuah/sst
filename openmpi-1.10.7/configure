$as_echo "$as_me: WARNING:     $opal_check_pmi_lib_dir/lib" >&2;}
                  { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING:     $opal_check_pmi_lib_dir/lib64" >&5
$as_echo "$as_me: WARNING:     $opal_check_pmi_lib_dir/lib64" >&2;}
                  { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: Specified path: $with_pmi_libdir" >&5
$as_echo "$as_me: WARNING: Specified path: $with_pmi_libdir" >&2;}
                  as_fn_error $? "Aborting" "$LINENO" 5
                  grpcomm_pmi_good=0
else
  { $as_echo "$as_me:${as_lineno-$LINENO}: result: yes" >&5
$as_echo "yes" >&6; }
                  opal_enable_pmi=1
                  grpcomm_pmi_LDFLAGS="$opal_check_pmi_grpcomm_pmi_LDFLAGS"
                  grpcomm_pmi_CPPFLAGS="$opal_check_pmi_grpcomm_pmi_CPPFLAGS"
                  grpcomm_pmi_LIBS="$opal_check_pmi_grpcomm_pmi_LIBS  -Wl,-rpath=$opal_pmi_rpath"
