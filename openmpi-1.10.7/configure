            if test $ofc_type_kind_value -le 0; then :
  ofc_have_type=0
                   { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: Compiler COMPLEX*32 and $ofc_c_type mismatch; MPI datatype unsupported" >&5
