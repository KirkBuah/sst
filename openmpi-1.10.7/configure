  if test -z "$OMPI_WRAPPER_EXTRA_LIBS"; then :
  OMPI_WRAPPER_EXTRA_LIBS=$arg
else
  OMPI_WRAPPER_EXTRA_LIBS="$OMPI_WRAPPER_EXTRA_LIBS $arg"
fi
fi
    done


