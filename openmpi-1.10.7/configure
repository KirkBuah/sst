  opal_check_pmi_pubsub_pmi_CPPFLAGS="-I$opal_check_pmi_install_dir/include"
fi
else
  # this could be SLURM, which puts things in a different location
                               if test -f "$opal_check_pmi_install_dir/include/slurm/pmi2.h"; then :
  # even if this was the default loc, we still need to add it in
                                       # because of the slurm path addition
                                       opal_check_pmi_have_hdr=yes
                                        opal_check_pmi_pubsub_pmi_CPPFLAGS="-I$opal_check_pmi_install_dir/include/slurm"
fi
fi
fi
fi

           # since support was explicitly requested, then we should error out
           # if we didn't find the required support
           { $as_echo "$as_me:${as_lineno-$LINENO}: checking if PMI support can be built" >&5
$as_echo_n "checking if PMI support can be built... " >&6; }
           if test "$opal_check_pmi_have_hdr" != "yes"; then :
  { $as_echo "$as_me:${as_lineno-$LINENO}: result: no" >&5
$as_echo "no" >&6; }
                  { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: PMI support requested (via --with-pmi) but neither pmi.h" >&5
$as_echo "$as_me: WARNING: PMI support requested (via --with-pmi) but neither pmi.h" >&2;}
                  { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: nor pmi2.h were found under locations:" >&5
$as_echo "$as_me: WARNING: nor pmi2.h were found under locations:" >&2;}
                  { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING:     $opal_check_pmi_install_dir" >&5
$as_echo "$as_me: WARNING:     $opal_check_pmi_install_dir" >&2;}
                  { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING:     $opal_check_pmi_install_dir/include" >&5
$as_echo "$as_me: WARNING:     $opal_check_pmi_install_dir/include" >&2;}
                  { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING:     $opal_check_pmi_install_dir/include/slurm" >&5
$as_echo "$as_me: WARNING:     $opal_check_pmi_install_dir/include/slurm" >&2;}
                  { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: Specified path: $with_pmi" >&5
$as_echo "$as_me: WARNING: Specified path: $with_pmi" >&2;}
                  as_fn_error $? "Aborting" "$LINENO" 5
                  pubsub_pmi_good=0
fi

           if test "$opal_have_pmi1" != "1" && test "$opal_have_pmi2" != "1"; then :
  { $as_echo "$as_me:${as_lineno-$LINENO}: result: no" >&5
$as_echo "no" >&6; }
                  { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: PMI support requested but neither libpmi nor libpmi2 were found under:" >&5
$as_echo "$as_me: WARNING: PMI support requested but neither libpmi nor libpmi2 were found under:" >&2;}
                  { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING:     $opal_check_pmi_lib_dir/lib" >&5
