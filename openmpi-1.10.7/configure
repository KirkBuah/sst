  { $as_echo "$as_me:${as_lineno-$LINENO}: result: not found" >&5
$as_echo "not found" >&6; }
                  { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: Directory $with_scif not found" >&5
$as_echo "$as_me: WARNING: Directory $with_scif not found" >&2;}
                  as_fn_error $? "Cannot continue" "$LINENO" 5
else
  if test "x`ls $with_scif/include/scif.h 2> /dev/null`" = "x"; then :
  { $as_echo "$as_me:${as_lineno-$LINENO}: result: not found" >&5
$as_echo "not found" >&6; }
                         { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: Expected file $with_scif/include/scif.h not found" >&5
$as_echo "$as_me: WARNING: Expected file $with_scif/include/scif.h not found" >&2;}
                         as_fn_error $? "Cannot continue" "$LINENO" 5
else
  { $as_echo "$as_me:${as_lineno-$LINENO}: result: sanity check ok ($with_scif)" >&5
$as_echo "sanity check ok ($with_scif)" >&6; }

fi


fi


fi


    btl_scif_happy="no"

    if test "$with_scif" != "no" ; then
	if test -n "$with_scif" -a "$with_scif" != "yes" ; then
	    ompi_check_scif_dir=$with_scif
	fi


    ompi_check_package_btl_scif_save_CPPFLAGS="$CPPFLAGS"
    ompi_check_package_btl_scif_save_LDFLAGS="$LDFLAGS"
    ompi_check_package_btl_scif_save_LIBS="$LIBS"

    ompi_check_package_btl_scif_orig_CPPFLAGS="$btl_scif_CPPFLAGS"
    ompi_check_package_btl_scif_orig_LDFLAGS="$btl_scif_LDFLAGS"
    ompi_check_package_btl_scif_orig_LIBS="$btl_scif_LIBS"


    # This is stolen from autoconf to peek under the covers to get the
    # cache variable for the library check.  one should not copy this
    # code into other places unless you want much pain and suffering


    # so this sucks, but there's no way to get through the progression
    # of header includes without killing off the cache variable and trying
    # again...
    unset ac_cv_header_scif_h

    ompi_check_package_header_happy="no"
    if test "$ompi_check_scif_dir" = "/usr" -o "$ompi_check_scif_dir" = "/usr/local"; then :
   # try as is...
            { $as_echo "$as_me:${as_lineno-$LINENO}: result: looking for header without includes" >&5
$as_echo "looking for header without includes" >&6; }
            for ac_header in scif.h
do :
  ac_fn_c_check_header_mongrel "$LINENO" "scif.h" "ac_cv_header_scif_h" "$ac_includes_default"
if test "x$ac_cv_header_scif_h" = xyes; then :
  cat >>confdefs.h <<_ACEOF
#define HAVE_SCIF_H 1
_ACEOF
 ompi_check_package_header_happy="yes"
fi

done

            if test "$ompi_check_package_header_happy" = "no"; then :
  # no go on the as is - reset the cache and try again
                   unset ac_cv_header_scif_h
fi
fi

    if test "$ompi_check_package_header_happy" = "no"; then :
  if test "$ompi_check_scif_dir" != ""; then :
  btl_scif_CPPFLAGS="$btl_scif_CPPFLAGS -I$ompi_check_scif_dir/include"
                  CPPFLAGS="$CPPFLAGS -I$ompi_check_scif_dir/include"
fi
          for ac_header in scif.h
do :
  ac_fn_c_check_header_mongrel "$LINENO" "scif.h" "ac_cv_header_scif_h" "$ac_includes_default"
if test "x$ac_cv_header_scif_h" = xyes; then :
  cat >>confdefs.h <<_ACEOF
#define HAVE_SCIF_H 1
_ACEOF
 ompi_check_package_header_happy="yes"
fi

done

	  if test "$ompi_check_package_header_happy" = "yes"; then :

    # This is stolen from autoconf to peek under the covers to get the
    # cache variable for the library check.  one should not copy this
    # code into other places unless you want much pain and suffering


    # see comment above
    unset ac_cv_search_scif_open
    ompi_check_package_lib_happy="no"
    if test "" != ""; then :
   # libdir was specified - search only there
           btl_scif_LDFLAGS="$btl_scif_LDFLAGS -L"
           LDFLAGS="$LDFLAGS -L"
           { $as_echo "$as_me:${as_lineno-$LINENO}: checking for library containing scif_open" >&5
$as_echo_n "checking for library containing scif_open... " >&6; }
if ${ac_cv_search_scif_open+:} false; then :
  $as_echo_n "(cached) " >&6
else
  ac_func_search_save_LIBS=$LIBS
cat confdefs.h - <<_ACEOF >conftest.$ac_ext
