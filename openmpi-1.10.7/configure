        fi
    done

fi

    MCA_orte_sensor_ALL_COMPONENTS="$all_components"
    MCA_orte_sensor_STATIC_COMPONENTS="$static_components"
    MCA_orte_sensor_DSO_COMPONENTS="$dso_components"
