$as_echo "sanity check ok ($with_xpmem_libdir)" >&6; }

fi


fi


fi


    ompi_check_xpmem_happy="no"

    if test ! "$with_xpmem" = "no" ; then
	if test ! -z "$with_xpmem" -a "$with_xpmem" != "yes" ; then
	    ompi_check_xpmem_dir="$with_xpmem"
	fi

	if test ! -z "$with_xpmem_libdir" -a "$with_xpmem_libdir" != "yes" ; then
	    ompi_check_xpmem_libdir="$with_xpmem_libdir"
	fi


    ompi_check_package_btl_vader_save_CPPFLAGS="$CPPFLAGS"
    ompi_check_package_btl_vader_save_LDFLAGS="$LDFLAGS"
    ompi_check_package_btl_vader_save_LIBS="$LIBS"

    ompi_check_package_btl_vader_orig_CPPFLAGS="$btl_vader_CPPFLAGS"
    ompi_check_package_btl_vader_orig_LDFLAGS="$btl_vader_LDFLAGS"
    ompi_check_package_btl_vader_orig_LIBS="$btl_vader_LIBS"


    # This is stolen from autoconf to peek under the covers to get the
    # cache variable for the library check.  one should not copy this
    # code into other places unless you want much pain and suffering


    # so this sucks, but there's no way to get through the progression
    # of header includes without killing off the cache variable and trying
    # again...
    unset ac_cv_header_xpmem_h

    ompi_check_package_header_happy="no"
    if test "$ompi_check_xpmem_dir" = "/usr" -o "$ompi_check_xpmem_dir" = "/usr/local"; then :
   # try as is...
            { $as_echo "$as_me:${as_lineno-$LINENO}: result: looking for header without includes" >&5
$as_echo "looking for header without includes" >&6; }
            for ac_header in xpmem.h
do :
  ac_fn_c_check_header_mongrel "$LINENO" "xpmem.h" "ac_cv_header_xpmem_h" "$ac_includes_default"
if test "x$ac_cv_header_xpmem_h" = xyes; then :
  cat >>confdefs.h <<_ACEOF
#define HAVE_XPMEM_H 1
_ACEOF
 ompi_check_package_header_happy="yes"
fi

done

            if test "$ompi_check_package_header_happy" = "no"; then :
  # no go on the as is - reset the cache and try again
                   unset ac_cv_header_xpmem_h
fi
fi

    if test "$ompi_check_package_header_happy" = "no"; then :
  if test "$ompi_check_xpmem_dir" != ""; then :
  btl_vader_CPPFLAGS="$btl_vader_CPPFLAGS -I$ompi_check_xpmem_dir/include"
                  CPPFLAGS="$CPPFLAGS -I$ompi_check_xpmem_dir/include"
fi
          for ac_header in xpmem.h
do :
  ac_fn_c_check_header_mongrel "$LINENO" "xpmem.h" "ac_cv_header_xpmem_h" "$ac_includes_default"
if test "x$ac_cv_header_xpmem_h" = xyes; then :
  cat >>confdefs.h <<_ACEOF
#define HAVE_XPMEM_H 1
_ACEOF
 ompi_check_package_header_happy="yes"
fi

done

	  if test "$ompi_check_package_header_happy" = "yes"; then :

    # This is stolen from autoconf to peek under the covers to get the
    # cache variable for the library check.  one should not copy this
    # code into other places unless you want much pain and suffering


    # see comment above
    unset ac_cv_search_xpmem_make
    ompi_check_package_lib_happy="no"
    if test "$ompi_check_xpmem_libdir" != ""; then :
   # libdir was specified - search only there
           btl_vader_LDFLAGS="$btl_vader_LDFLAGS -L$ompi_check_xpmem_libdir"
           LDFLAGS="$LDFLAGS -L$ompi_check_xpmem_libdir"
           { $as_echo "$as_me:${as_lineno-$LINENO}: checking for library containing xpmem_make" >&5
$as_echo_n "checking for library containing xpmem_make... " >&6; }
